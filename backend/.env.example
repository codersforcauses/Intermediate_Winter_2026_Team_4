# Copy to backend/.env and fill in. The .env file is git-ignored.

# --- Adzuna (required for live job search) -----------------------------------
# Free keys from https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=au

# --- Django (optional for local development) ---------------------------------
# Defaults are fine locally. For any deployment, turn debug off and set a real
# secret key (the app refuses to start with DJANGO_DEBUG=false and no key).
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=jobrader.example.com

# Origins allowed to call the API / submit forms (comma-separated).
# Default: http://localhost:3000,http://127.0.0.1:3000
# CORS_ALLOWED_ORIGINS=
# CSRF_TRUSTED_ORIGINS=
